-- Calculated column: order_analysis
order_date =
IF(
    ISBLANK(order_analysis[purchase_date]),
    BLANK(),
    DATE(
        YEAR(order_analysis[purchase_date]),
        MONTH(order_analysis[purchase_date]),
        DAY(order_analysis[purchase_date])
    )
)

-- Calculated column: order_analysis
Delivery Group =
IF(
    ISBLANK(order_analysis[late_delivery_flag]),
    BLANK(),
    IF(order_analysis[late_delivery_flag] = 1, "Late", "On time")
)

-- Calculated table
DimDate =
ADDCOLUMNS(
    CALENDAR(DATE(2016, 1, 1), DATE(2018, 12, 31)),
    "Year", YEAR([Date]),
    "YearMonth", FORMAT([Date], "yyyy-MM"),
    "TrendPeriod", IF([Date] >= DATE(2017, 1, 1) && [Date] < DATE(2018, 9, 1), 1, 0)
)

-- Measures: create each separately
Total Orders = COUNTROWS(order_analysis)

Delivered Orders =
CALCULATE([Total Orders], order_analysis[order_status] = "delivered")

Product Revenue =
CALCULATE(
    SUM(order_analysis[product_revenue]),
    order_analysis[order_status] = "delivered"
)

Average Order Value = DIVIDE([Product Revenue], [Delivered Orders])

Delivered Customers =
CALCULATE(
    DISTINCTCOUNT(order_analysis[customer_unique_id]),
    order_analysis[order_status] = "delivered"
)

Repeat Customers =
COUNTROWS(
    FILTER(
        VALUES(order_analysis[customer_unique_id]),
        [Delivered Orders] > 1
    )
)

Repeat Customer Rate = DIVIDE([Repeat Customers], [Delivered Customers])

Category Revenue =
CALCULATE(
    SUM(order_items[price]),
    order_analysis[order_status] = "delivered"
)

Eligible Deliveries = COUNT(order_analysis[late_delivery_flag])

Late Orders =
CALCULATE([Total Orders], order_analysis[late_delivery_flag] = 1)

Late Delivery Rate = DIVIDE([Late Orders], [Eligible Deliveries])

Average Delivery Review =
CALCULATE(
    AVERAGE(order_analysis[average_review_score]),
    NOT ISBLANK(order_analysis[late_delivery_flag])
)

Group Eligible Deliveries =
CALCULATE(
    [Eligible Deliveries],
    KEEPFILTERS(
        TREATAS(VALUES(order_items[order_id]), order_analysis[order_id])
    )
)

Group Late Orders =
COALESCE(
    CALCULATE(
        [Late Orders],
        KEEPFILTERS(
            TREATAS(VALUES(order_items[order_id]), order_analysis[order_id])
        )
    ),
    0
)

Group Late Delivery Rate =
DIVIDE([Group Late Orders], [Group Eligible Deliveries])
